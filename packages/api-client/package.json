{
  "name": "@afb/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client used by all three portals: one Axios instance, Bearer-token handling, typed errors, one function per endpoint.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@afb/types": "*",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
