# Settings for `docker compose up --build` (copy to .env to change them; all are optional).
# The API's own development settings live in services/api/.env.example.

# PostgreSQL
POSTGRES_USER=afb
POSTGRES_PASSWORD=afb
POSTGRES_DB=advanced_faculty_booking
POSTGRES_PORT=5433

# API — set a long random JWT_SECRET (32+ characters) so sessions survive restarts, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
API_PORT=4000
LOG_LEVEL=info
BCRYPT_COST=12

# Portals
STUDENT_PORT=8081
FACULTY_PORT=8082
ADMIN_PORT=8083
