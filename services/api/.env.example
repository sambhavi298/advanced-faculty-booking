# Copy to services/api/.env and adjust. Every variable is validated at startup (src/config/env.ts);
# the API refuses to start with a clear message if one is missing or malformed.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL 18 — matches the `db` service in the root docker-compose.yml (host port 5433).
DATABASE_URL=postgres://afb:afb@127.0.0.1:5433/advanced_faculty_booking
DATABASE_POOL_MAX=10

# Integration tests run against a separate database so they never touch development data.
TEST_DATABASE_URL=postgres://afb:afb@127.0.0.1:5433/advanced_faculty_booking_test

# Comma-separated browser origins allowed to call the API directly (the three Vite dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Signing key for login tokens (HS256). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The value below is for local development only; the API refuses to start with it in production.
JWT_SECRET=change-me-local-development-secret-at-least-32-chars
# How long a login stays valid (s, m, h or d).
JWT_EXPIRES_IN=8h

# Brute-force protection: login attempts allowed per client + login ID per window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=15m

# Set to true only when the API runs behind a reverse proxy (Docker/nginx) so client IPs are correct.
TRUST_PROXY=false

# How often appointments whose time has passed are completed / expired.
APPOINTMENT_SWEEP_INTERVAL=1m

# fatal | error | warn | info | debug | trace | silent  (defaults: debug in development, info in production, silent in tests)
# LOG_LEVEL=debug
