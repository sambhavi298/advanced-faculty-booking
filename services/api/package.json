{
  "name": "@afb/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Faculty Appointment Booking System (Express 5 + node-postgres, Repository → Service → Controller).",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db": "tsx src/db/cli.ts",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:status": "tsx src/db/cli.ts status",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:setup": "tsx src/db/cli.ts setup",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:fresh": "tsx src/db/cli.ts fresh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@afb/types": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15"
  }
}
